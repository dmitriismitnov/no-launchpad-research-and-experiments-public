{
    "$schema": "https://opencode.ai/config.json",

    // Agent rule files loaded into context automatically.
    "instructions": ["AGENTS.md", ".agents/*.md"],

    "permission": {
        // Secrets: never read committed environment files.
        // Broad allow first; narrow rules must come last (the last match wins).
        "read": {
            "*": "allow",
            "**/.env": "deny",
            "**/.env.*": "deny",
            // Safe example file and local, git-ignored overrides.
            "**/.env.example": "allow",
            "**/.env.local": "allow",
            "**/.mise.local.toml": "allow"
        },

        // Generated output, build output and lock files are managed by tooling.
        "edit": {
            "*": "allow",
            "src/shared/styled-system/**": "deny",
            "**/*.generated.*": "deny",
            "**/*.gen.*": "deny",
            "dist/**": "deny",
            "bun.lock": "deny"
        },

        // Unknown commands stay under user control.
        "bash": {
            "*": "ask",
            "git status *": "allow",
            "git diff *": "allow",
            "git log *": "allow",
            "git show *": "allow",
            "mise tasks*": "allow",
            "mise run check*": "allow",
            "mise run fix*": "allow",
            "mise run gen*": "allow",
            "bunx --no-install dprint *": "allow",
            "bunx --no-install eslint *": "allow",
            "rm -rf *": "deny",
            "git push --force*": "deny",
            "git reset --hard*": "deny",
            "git clean -fd*": "deny"
        },

        "external_directory": "ask",
        "doom_loop": "ask"
    },

    "references": {},

    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            ".git/**",
            "storybook-static/**",
            "src/shared/styled-system/**",
            "test-results/**"
        ]
    }
}
