{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

    // Entry points missing from Knip's standard plugins.
    "entry": [
        "src/main.tsx",
        "src/shared/styles/index.ts",
        "src/shared/styles/settings/index.ts",
        "src/shared/styles/foundation/index.ts",
        "src/shared/components/alert/index.ts",
        "src/shared/components/avatar/index.ts",
        "src/shared/components/badge/index.ts",
        "src/shared/components/button/index.ts",
        "src/shared/components/button-icon/index.ts",
        "src/shared/components/card/index.ts",
        "src/shared/components/clipboard/index.ts",
        "src/shared/components/code-block/index.ts",
        "src/shared/components/divider/index.ts",
        "src/shared/components/empty-state/index.ts",
        "src/shared/components/icon/index.ts",
        "src/shared/components/icon/tools/build.ts",
        "src/shared/components/icon/tools/update.ts",
        "src/shared/components/input/index.ts",
        "src/shared/components/list/index.ts",
        "src/shared/components/progress/index.ts",
        "src/shared/components/progress-ring/index.ts",
        "src/shared/components/skeleton/index.ts",
        "src/shared/components/spinner/index.ts",
        "src/shared/components/statistic/index.ts",
        "src/shared/components/status-indicator/index.ts",
        "src/shared/components/tag/index.ts",
        "src/shared/components/timeline/index.ts",
        "src/shared/components/toast/index.ts",
        "src/shared/utils/index.ts",
        ".storybook/*.ts",
        "test/**/*.{ts,tsx}",
        "*.config.{js,mjs,cjs,ts,mts,cts}"
    ],

    // Hand-written files included in the analysis.
    "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        ".storybook/**/*.{ts,tsx}",
        "*.{js,mjs,cjs,ts,mts,cts}",
        "*.config.{js,mjs,cjs,ts,mts,cts}"
    ],

    // Generated artifacts are produced by a pipeline, not hand-written; their
    // usage is validated by their own build/check tasks, not by dead-code
    // analysis. Keep this in sync with dprint and ESLint.
    "ignore": [
        "**/*.generated.*"
    ],

    // Used through mise, hooks or external CLI configs.
    "ignoreDependencies": [
        "@commitlint/cli",
        "@pandacss/config",
        "@pandacss/dev",
        "@storybook/addon-a11y",
        "@storybook/addon-docs",
        "@storybook/addon-vitest",
        "@storybook/react-vite",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "dprint",
        "husky",
        "lint-staged",
        "playwright",
        "postcss",
        "storybook"
    ],

    // `mise` is a project tool, not an npm dependency.
    "ignoreBinaries": ["mise"]
}
