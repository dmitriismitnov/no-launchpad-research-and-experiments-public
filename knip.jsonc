{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

    // Entry points missing from Knip's standard plugins.
    "entry": [
        "src/main.tsx",
        "src/shared/styles/index.ts",
        "src/shared/styles/settings/index.ts",
        "src/shared/styles/foundation/index.ts",
        "src/shared/components/accordion-item/index.ts",
        "src/shared/components/alert/index.ts",
        "src/shared/components/alert-dialog/index.ts",
        "src/shared/components/avatar/index.ts",
        "src/shared/components/badge/index.ts",
        "src/shared/components/brand/index.ts",
        "src/shared/components/breadcrumbs/index.ts",
        "src/shared/components/button/index.ts",
        "src/shared/components/button-icon/index.ts",
        "src/shared/components/card/index.ts",
        "src/shared/components/carousel/index.ts",
        "src/shared/components/clipboard/index.ts",
        "src/shared/components/code-block/index.ts",
        "src/shared/components/context-menu/index.ts",
        "src/shared/components/data-table/index.ts",
        "src/shared/components/dialog/index.ts",
        "src/shared/components/divider/index.ts",
        "src/shared/components/drawer/index.ts",
        "src/shared/components/empty-state/index.ts",
        "src/shared/components/field/index.ts",
        "src/shared/components/floating-panel/index.ts",
        "src/shared/components/hover-card/index.ts",
        "src/shared/components/icon/index.ts",
        "src/shared/components/icon/tools/build.ts",
        "src/shared/components/icon/tools/update.ts",
        "src/shared/components/input/index.ts",
        "src/shared/components/checkbox/index.ts",
        "src/shared/components/number-input/index.ts",
        "src/shared/components/radio/index.ts",
        "src/shared/components/radio-group/index.ts",
        "src/shared/components/slider/index.ts",
        "src/shared/components/switch/index.ts",
        "src/shared/components/textarea/index.ts",
        "src/shared/components/toggle/index.ts",
        "src/shared/components/toggle-group/index.ts",
        "src/shared/components/link/index.ts",
        "src/shared/components/list/index.ts",
        "src/shared/components/media-placeholder/index.ts",
        "src/shared/components/menu/index.ts",
        "src/shared/components/multi-select/index.ts",
        "src/shared/components/nav-item/index.ts",
        "src/shared/components/pagination/index.ts",
        "src/shared/components/pin-input/index.ts",
        "src/shared/components/popover/index.ts",
        "src/shared/components/progress/index.ts",
        "src/shared/components/progress-ring/index.ts",
        "src/shared/components/qr-code/index.ts",
        "src/shared/components/scroll-area/index.ts",
        "src/shared/components/select/index.ts",
        "src/shared/components/sheet/index.ts",
        "src/shared/components/sidebar-item/index.ts",
        "src/shared/components/skeleton/index.ts",
        "src/shared/components/spinner/index.ts",
        "src/shared/components/splitter/index.ts",
        "src/shared/components/statistic/index.ts",
        "src/shared/components/status-indicator/index.ts",
        "src/shared/components/step/index.ts",
        "src/shared/components/tab/index.ts",
        "src/shared/components/tag/index.ts",
        "src/shared/components/timeline/index.ts",
        "src/shared/components/toast/index.ts",
        "src/shared/components/tooltip/index.ts",
        "src/shared/components/top-navigation/index.ts",
        "src/shared/components/tour/index.ts",
        "src/shared/components/tree-item/index.ts",
        "src/shared/utils/index.ts",
        ".storybook/*.ts",
        "test/**/*.{ts,tsx}",
        "*.config.{js,mjs,cjs,ts,mts,cts}"
    ],

    // Hand-written files included in the analysis.
    "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        ".storybook/**/*.{ts,tsx}",
        "*.{js,mjs,cjs,ts,mts,cts}",
        "*.config.{js,mjs,cjs,ts,mts,cts}"
    ],

    // Generated artifacts are produced by a pipeline, not hand-written; their
    // usage is validated by their own build/check tasks, not by dead-code
    // analysis. Keep this in sync with dprint and ESLint.
    "ignore": [
        "**/*.generated.*"
    ],

    // Used through mise, hooks or external CLI configs.
    "ignoreDependencies": [
        "@commitlint/cli",
        "@pandacss/config",
        "@pandacss/dev",
        "@storybook/addon-a11y",
        "@storybook/addon-docs",
        "@storybook/addon-vitest",
        "@storybook/react-vite",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "dprint",
        "husky",
        "lint-staged",
        "playwright",
        "postcss",
        "storybook"
    ],

    // `mise` is a project tool, not an npm dependency.
    "ignoreBinaries": ["mise"]
}
