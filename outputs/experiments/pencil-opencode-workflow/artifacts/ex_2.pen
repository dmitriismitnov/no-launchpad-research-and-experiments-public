                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Messages about state and outcome — Alert and Toast — and passive indicators of status, progress and loading: Badge, Tag, Status Indicator, Progress, Spinner, Skeleton and Empty State.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
                  "fontWeight": "$font-weight/regular"
