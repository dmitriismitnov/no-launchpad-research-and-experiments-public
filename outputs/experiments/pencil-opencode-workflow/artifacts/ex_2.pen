              "fontFamily": "$font/mono",
              "fontSize": "$font-size/xs",
              "fontWeight": "$font-weight/medium",
              "letterSpacing": "$tracking/wide"
            },
            {
              "type": "text",
              "id": "AWZxW",
              "name": "Title",
              "fill": "$semantic/text/primary",
              "content": "No Launchpad Design System",
              "lineHeight": "$line-height/tight",
              "fontFamily": "$font/body",
              "fontSize": "$font-size/3xl",
              "fontWeight": "$font-weight/bold",
              "letterSpacing": "$tracking/tight"
            },
            {
              "type": "text",
              "id": "ibHg5",
              "name": "Description",
              "fill": "$semantic/text/secondary",
              "textGrowth": "fixed-width",
              "width": 820,
              "content": "A component-scoped system. Foundation owns primitive and semantic tokens, themes, spacing, typography, shape and effects. Every component owns its own anatomy, public variants and visual states.",
              "lineHeight": "$line-height/relaxed",
              "fontFamily": "$font/body",
              "fontSize": "$font-size/md",
              "fontWeight": "normal"
            }
          ]
        },
