                  "id": "B8IfI",
                  "name": "Cap",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Toast confirms without blocking. Alert states a condition inline where the user will act. Alert Dialog blocks, and lives in Overlays because it is a modal surface.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
                  "fontWeight": "$font-weight/regular"
                }
              ]
