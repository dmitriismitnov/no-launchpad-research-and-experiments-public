                {
                  "type": "text",
                  "id": "EaMio",
                  "name": "Rule",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "· The menu opens at the pointer and flips to stay on screen.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
                  "fontWeight": "$font-weight/regular"
                },
                {
                  "type": "text",
                  "id": "A0JVXM",
                  "name": "Rule",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "· Right click must never be the only way to reach the actions.",
                  "lineHeight": "$line-height/normal",
