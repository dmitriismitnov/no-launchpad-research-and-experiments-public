              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "NxOm7",
                  "name": "Title",
                  "fill": "$semantic/text/primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Components — Overlays",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/3xl",
                  "fontWeight": "$font-weight/semibold"
                },
                {
                  "type": "text",
                  "id": "LzgEe",
                  "name": "Purpose",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Surfaces layered above the page, from a one-line hint to a blocking task. Choose the lightest surface that carries the job: tooltip, then popover or hover card, then drawer or sheet, and only then a dialog.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/md",
                  "fontWeight": "$font-weight/regular"
                }
              ]
            },
            {
              "type": "frame",
              "id": "lQTwM",
              "name": "What belongs to this category",
              "width": "fill_container",
              "stroke": "$semantic/border/subtle",
              "strokeWidth": {
                "top": 1
              },
              "layout": "vertical",
              "gap": 12,
              "padding": [
                22,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "t60t0W",
                  "name": "Section label",
                  "fill": "$semantic/text/tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What belongs to this category",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/mono",
                  "fontSize": "$font-size/xs",
                  "fontWeight": "$font-weight/regular"
                },
                {
                  "type": "text",
                  "id": "tk3eG",
                  "name": "Cap",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Anything that appears above the page on an anchored or modal surface: tooltip, popover, hover card, dialog, alert dialog, drawer, sheet, floating panel and tour.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
                  "fontWeight": "$font-weight/regular"
                }
              ]
            },
            {
              "type": "frame",
              "id": "eFSGB",
              "name": "Escalation ladder",
              "width": "fill_container",
              "stroke": "$semantic/border/subtle",
              "strokeWidth": {
                "top": 1
              },
              "layout": "vertical",
              "gap": 12,
              "padding": [
                22,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "TeCJA",
                  "name": "Section label",
                  "fill": "$semantic/text/tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Escalation ladder",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/mono",
                  "fontSize": "$font-size/xs",
                  "fontWeight": "$font-weight/regular"
                },
                {
                  "type": "text",
                  "id": "k1BudQ",
                  "name": "Cap",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Tooltip names and never blocks. Popover and Hover Card anchor and dismiss on Escape. Drawer, Sheet and Floating Panel hold work while the page stays visible. Dialog and Alert Dialog block until resolved.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
                  "fontWeight": "$font-weight/regular"
                }
              ]
            },
            {
              "type": "frame",
              "id": "WQ5Q6",
              "name": "Scrim and focus",
              "width": "fill_container",
              "stroke": "$semantic/border/subtle",
              "strokeWidth": {
                "top": 1
              },
              "layout": "vertical",
              "gap": 12,
              "padding": [
