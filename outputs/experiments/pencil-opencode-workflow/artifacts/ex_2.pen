                {
                  "type": "text",
                  "id": "Er3z5",
                  "name": "Rule",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "· Label is a verb phrase in sentence case: Save changes, Delete component.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
                  "fontWeight": "$font-weight/regular"
                },
                {
                  "type": "text",
                  "id": "cWT1z",
                  "name": "Rule",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "· One primary action per region; everything else is secondary or ghost.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
                  "fontWeight": "$font-weight/regular"
                },
                {
                  "type": "text",
                  "id": "UXqQK",
                  "name": "Rule",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "· destructive is reserved for irreversible actions and always names the target.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
