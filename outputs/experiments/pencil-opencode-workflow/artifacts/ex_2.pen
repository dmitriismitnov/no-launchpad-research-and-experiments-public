                  "id": "iWaFd",
                  "name": "Cap",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Tag is interactive when it is removable or selectable and therefore has hover, focus-visible and disabled. Badge, Spinner, Skeleton and Status Indicator are passive: tone or shape is the whole contract.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
                  "fontWeight": "$font-weight/regular"
