                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "XdMua",
                  "name": "Section label",
                  "fill": "$semantic/text/tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Scrim and focus",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/mono",
                  "fontSize": "$font-size/xs",
                  "fontWeight": "$font-weight/regular"
                },
                {
                  "type": "text",
                  "id": "RMR8f",
                  "name": "Cap",
                  "fill": "$semantic/text/secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Only Dialog, Alert Dialog and Drawer use a scrim. Every modal traps focus, moves it inside on open and returns it to the trigger on close. Escape closes all overlays except a destructive confirmation that requires an explicit choice.",
                  "lineHeight": "$line-height/normal",
                  "fontFamily": "$font/body",
                  "fontSize": "$font-size/sm",
                  "fontWeight": "$font-weight/regular"
                }
              ]
            },
            {
              "type": "frame",
              "id": "v4gb5",
