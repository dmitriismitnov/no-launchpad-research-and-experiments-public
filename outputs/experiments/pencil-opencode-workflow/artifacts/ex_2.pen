                  "fontWeight": "$font-weight/regular"
                },
                {
                  "type": "frame",
                  "id": "HfqEc",
                  "name": "Themes",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 20,
                  "children": [
                    {
                      "type": "frame",
                      "id": "b5Y5M",
                      "name": "theme light",
                      "theme": {
                        "theme": "light"
                      },
